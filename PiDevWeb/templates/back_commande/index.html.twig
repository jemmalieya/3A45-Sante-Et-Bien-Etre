{% extends 'base_back.html.twig' %}
{% block title %}Gestion des commandes{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            
            {# En-tête #}
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="bi bi-box-seam"></i> Gestion des commandes</h2>
                    <p class="text-muted">{{ commandes|length }} commande(s) au total</p>
                </div>
            </div>

            {# Messages Flash #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle-fill me-2"></i>{{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {# Tableau des commandes #}
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Date</th>
                                    <th>Client</th>
                                    <th>Montant</th>
                                    <th>Statut</th>
                                    <th>Produits</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if commandes is empty %}
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                                        <p class="mt-3">Aucune commande</p>
                                    </td>
                                </tr>
                                {% else %}
                                    {% for commande in commandes %}
                                    <tr>
                                        <td class="fw-bold">#{{ commande.idCommande }}</td>
                                        <td>{{ commande.dateCreationCommande|date('d/m/Y H:i') }}</td>
                                        <td>User #{{ commande.idUser }}</td>
                                        <td class="fw-bold text-success">{{ commande.montantTotal|number_format(2, '.', '') }} €</td>
                                        <td>
                                            {% if commande.statutCommande == 'En attente' %}
                                                <span class="badge bg-warning text-dark">{{ commande.statutCommande }}</span>
                                            {% elseif commande.statutCommande == 'En cours' %}
                                                <span class="badge bg-info">{{ commande.statutCommande }}</span>
                                            {% elseif commande.statutCommande == 'Expédiée' %}
                                                <span class="badge bg-primary">{{ commande.statutCommande }}</span>
                                            {% elseif commande.statutCommande == 'Livrée' %}
                                                <span class="badge bg-success">{{ commande.statutCommande }}</span>
                                            {% else %}
                                                <span class="badge bg-danger">{{ commande.statutCommande }}</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">{{ commande.ligneCommandes|length }} produit(s)</span>
                                        </td>
                                        <td class="text-end">
                                            <a href="{{ path('admin_commande_show', {id: commande.idCommande}) }}" 
                                               class="btn btn-sm btn-primary">
                                                <i class="bi bi-eye"></i> Détails
                                            </a>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}