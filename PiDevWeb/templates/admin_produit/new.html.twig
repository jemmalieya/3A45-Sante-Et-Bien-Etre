{% extends 'base_back.html.twig' %}

{% block title %}Ajouter un produit{% endblock %}

{% block body %}
<h2 class="mb-4 text-center">Ajouter un produit</h2>

{# Flash message succès #}
{% for message in app.flashes('success') %}
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    {{ message }}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
{% endfor %}

<div class="card shadow-sm">
  <div class="card-body">
    {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}

    {# Nom Produit #}
    <div class="col-md-6">
      {{ form_label(form.nom_produit, 'Nom du produit', {'label_attr': {'class': 'form-label'}}) }}
      {{ form_widget(form.nom_produit, {'attr': {'class': 'form-control'}}) }}
      {{ form_errors(form.nom_produit) }}
    </div>

    {# Prix #}
    <div class="col-md-6">
      {{ form_label(form.prix_produit, 'Prix (€)', {'label_attr': {'class': 'form-label'}}) }}
      {{ form_widget(form.prix_produit, {'attr': {'class': 'form-control'}}) }}
      {{ form_errors(form.prix_produit) }}
    </div>

    {# Quantité #}
    <div class="col-md-6">
      {{ form_label(form.quantite_produit, 'Quantité', {'label_attr': {'class': 'form-label'}}) }}
      {{ form_widget(form.quantite_produit, {'attr': {'class': 'form-control'}}) }}
      {{ form_errors(form.quantite_produit) }}
    </div>

    {# Catégorie #}
    <div class="col-md-6">
      {{ form_label(form.categorie_produit, 'Catégorie', {'label_attr': {'class': 'form-label'}}) }}
      {{ form_widget(form.categorie_produit, {'attr': {'class': 'form-control'}}) }}
      {{ form_errors(form.categorie_produit) }}
    </div>

    {# Status #}
    <div class="col-md-6">
      {{ form_label(form.status_produit, 'Status', {'label_attr': {'class': 'form-label'}}) }}
      {{ form_widget(form.status_produit, {'attr': {'class': 'form-control'}}) }}
      {{ form_errors(form.status_produit) }}
    </div>

    {# Image URL #}
    <div class="col-md-6">
      {{ form_label(form.image_produit, 'Image (URL)', {'label_attr': {'class': 'form-label'}}) }}
      {{ form_widget(form.image_produit, {'attr': {'class': 'form-control'}}) }}
      {{ form_errors(form.image_produit) }}
    </div>

    <div class="col-12 mt-3 d-flex gap-2">
      <button type="submit" class="btn btn-primary">Ajouter</button>
      <a href="{{ path('admin_produit_index') }}" class="btn btn-outline-secondary">Annuler</a>
    </div>

    {{ form_end(form) }}
  </div>
</div>

{# Script JS validation temps réel #}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const fields = ['nomProduit','prixProduit','quantiteProduit','imageProduit','statusProduit'];

  fields.forEach(field => {
    const input = document.getElementById('produit_' + field);
    if (!input) return;

    input.addEventListener('input', () => {
      fetch('/admin/produits/validate/' + field, {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: new URLSearchParams({value: input.value})
      })
      .then(resp => resp.json())
      .then(data => {
        if (data.valid) {
          input.classList.remove('is-invalid');
          input.classList.add('is-valid');
          if(input.nextElementSibling && input.nextElementSibling.classList.contains('invalid-feedback')) {
            input.nextElementSibling.remove();
          }
        } else {
          input.classList.remove('is-valid');
          input.classList.add('is-invalid');
          if(!input.nextElementSibling || !input.nextElementSibling.classList.contains('invalid-feedback')) {
            const div = document.createElement('div');
            div.className = 'invalid-feedback';
            div.textContent = data.message;
            input.parentNode.appendChild(div);
          } else {
            input.nextElementSibling.textContent = data.message;
          }
        }
      });
    });
  });
});
</script>
{% endblock %}
