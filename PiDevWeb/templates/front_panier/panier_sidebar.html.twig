{% extends 'base_front.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<div class="container mt-5 pt-5">
  {# Toast container centré #}
  <div class="position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1050; max-width:400px;" id="toast-container"></div>

  {# Confirmation custom overlay #}
  <div id="confirmOverlay" class="confirm-overlay d-none">
    <div class="confirm-box">
      <p id="confirmMessage"></p>
      <div class="confirm-buttons">
        <button class="btn btn-danger" id="confirmYes">Oui</button>
        <button class="btn btn-secondary" id="confirmNo">Non</button>
      </div>
    </div>
  </div>

  <h2 class="text-center mb-4">Mon Panier</h2>

  {% if produits is empty %}
    <p class="text-center">Votre panier est vide.</p>
    <div class="text-center mt-4">
      <a href="{{ path('front_produit_index') }}" class="btn btn-primary">Retour aux produits</a>
    </div>
  {% else %}
    <div class="sidebar-panier p-3 border rounded" style="max-width:800px; margin:auto; background:linear-gradient(to right, #003399, #00bf6f); color:white;">
      <table class="table table-borderless text-white">
        <thead>
          <tr>
            <th>Produit</th>
            <th>Qté</th>
            <th>Prix (DT)</th>
            <th>Total (DT)</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for produit in produits %}
            <tr class="align-middle produit-row"
                onmouseover="this.style.background='rgba(255,255,255,0.1)'"
                onmouseout="this.style.background='transparent'">
              <td>
                <img src="{{ produit.imageProduit }}" alt="{{ produit.nomProduit }}" style="width:60px; border-radius:5px; margin-right:8px;">
                {{ produit.nomProduit }}
              </td>

              {# ✅ Qté avec + / - #}
              <td>
                <div class="qty-wrap">
                  <button class="btn btn-light btn-sm btn-qty btn-minus"
                          data-id="{{ produit.id_produit }}" type="button">−</button>

                  <span class="fw-bold qty-value"
                        id="qty-{{ produit.id_produit }}"
                        data-price="{{ produit.prixProduit }}"
                        data-stock="{{ produit.quantiteProduit }}">
                    {{ produit.quantite_panier }}
                  </span>

                  <button class="btn btn-light btn-sm btn-qty btn-plus"
                          data-id="{{ produit.id_produit }}" type="button">+</button>
                </div>
              </td>

              <td>{{ produit.prixProduit }} DT</td>

              {# ✅ total ligne dynamique #}
              <td>
                <span class="line-total" id="line-{{ produit.id_produit }}">
                  {{ produit.prixProduit * produit.quantite_panier }}
                </span> DT
              </td>

              <td>
                <button class="btn btn-danger btn-sm btn-supprimer"
                        data-id="{{ produit.id_produit }}"
                        data-nom="{{ produit.nomProduit }}"
                        data-message="{{ produit.nomProduit }} supprimé du panier !">
                  Supprimer
                </button>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="text-end mt-3">
        <h4>Total : <span id="cart-total">{{ total }}</span> DT</h4>
        <button class="btn btn-warning" id="btnViderPanier" data-message="Panier vidé avec succès !">Vider le panier</button>
      </div>
    </div>
  {% endif %}
</div>

{# ✅ CSS externe (public/assets/css/...) #}
<link rel="stylesheet" href="{{ asset('assets/css/panier-qty.css') }}">

<script>
document.addEventListener('DOMContentLoaded', () => {
  const toastContainer = document.getElementById('toast-container');
  const confirmOverlay = document.getElementById('confirmOverlay');
  const confirmMessage = document.getElementById('confirmMessage');
  const confirmYes = document.getElementById('confirmYes');
  const confirmNo = document.getElementById('confirmNo');

  let currentUrl = null;
  let currentMessage = null;

  function showToast(message, color='success') {
    const toastEl = document.createElement('div');
    toastEl.className = `toast align-items-center text-white bg-${color} border-dark`;
    toastEl.role = 'alert';
    toastEl.ariaLive = 'assertive';
    toastEl.ariaAtomic = 'true';
    toastEl.innerHTML = `
      <div class="d-flex">
        <div class="toast-body">${message}</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>`;
    toastContainer.appendChild(toastEl);
    const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
    toast.show();
  }

  // ✅ accessible depuis panier-qty.js
  window.showToast = showToast;

  // Supprimer produit avec confirmation custom
  document.querySelectorAll('.btn-supprimer').forEach(btn => {
    btn.addEventListener('click', () => {
      currentUrl = `/panier/supprimer/${btn.dataset.id}`;
      currentMessage = btn.dataset.message;
      confirmMessage.textContent = `Êtes-vous sûr de supprimer ${btn.dataset.nom} du panier ?`;
      confirmOverlay.classList.remove('d-none');
    });
  });

  // Vider panier
  const btnVider = document.getElementById('btnViderPanier');
  if(btnVider){
    btnVider.addEventListener('click', () => {
      currentUrl = '/panier/vider';
      currentMessage = btnVider.dataset.message;
      confirmMessage.textContent = 'Êtes-vous sûr de vider le panier ?';
      confirmOverlay.classList.remove('d-none');
    });
  }

  // Bouton Oui
  confirmYes.addEventListener('click', () => {
    window.location.href = currentUrl;
    confirmOverlay.classList.add('d-none');
    setTimeout(() => showToast(currentMessage), 500);
  });

  // Bouton Non
  confirmNo.addEventListener('click', () => {
    confirmOverlay.classList.add('d-none');
  });

  // Toasts flash Symfony
  {% for message in app.flashes('success') %}
    showToast("{{ message|e }}");
  {% endfor %}
  {% for message in app.flashes('error') %}
    showToast("{{ message|e }}", 'danger');
  {% endfor %}
});
</script>

{# ✅ JS externe (public/assets/js/...) #}
<script src="{{ asset('assets/js/panier-qty.js') }}"></script>

<style>
/* Popup confirmation custom */
.confirm-overlay {
  position: fixed;
  top:0; left:0; width:100%; height:100%;
  background: rgba(0,0,0,0.5);
  display:flex;
  justify-content:center;
  align-items:center;
  z-index: 2000;
}
.confirm-box {
  background:white;
  padding:20px;
  border-radius:10px;
  box-shadow:0 5px 20px rgba(0,0,0,0.3);
  text-align:center;
  max-width: 400px;
  width:90%;
}
.confirm-buttons {
  display:flex;
  justify-content: space-around;
  margin-top:15px;
}
</style>
{% endblock %}
