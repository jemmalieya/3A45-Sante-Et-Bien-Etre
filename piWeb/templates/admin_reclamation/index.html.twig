{% extends 'base_admin.html.twig' %}

{% block title %}Administration - Réclamations{% endblock %}

{% block body %}
<div class="container">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="mb-1">Espace administrateur</h2>
      <p class="text-muted mb-0">
        Gestion complète des réclamations
      </p>
    </div>
  </div>

  <!-- FLASH MESSAGES -->
  {% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  {% endfor %}

  <!-- TABLE -->
  {% if reclamations is empty %}
    <div class="alert alert-info">
      Aucune réclamation trouvée.
    </div>
  {% else %}
    <div class="card shadow-sm border-0">
      <div class="card-body p-0">

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Référence</th>
                <th>Contenu</th>
                <th>Description</th>
                <th>Type</th>
                <th>Pièce jointe</th>
                <th>Statut</th>
                <th>Priorité</th>
                
                <th>Date création</th>
                <th>Date limite</th>
                <th>Date modification</th>
                <th>Date clôture</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>

            <tbody>
            {% for r in reclamations %}
              <tr>
                <td>{{ r.referenceReclamation }}</td>

                <td>{{ r.contenu }}</td>

                <td style="max-width: 250px;">
                  <small class="text-muted">
                    {{ r.description }}
                  </small>
                </td>

                <td>{{ r.type }}</td>

                <td>
                  {% if r.pieceJointePath %}
                    <a href="{{ asset('uploads/reclamations/' ~ r.pieceJointePath) }}"
                       target="_blank"
                       class="btn btn-sm btn-outline-secondary">
                      Voir
                    </a>
                  {% else %}
                    —
                  {% endif %}
                </td>

                <td>{{ r.statutReclamation }}</td>

                <td>
                   {% if r.isUrgente %}
                        <span class="badge bg-danger">URGENTE</span>
                      {% else %}
                        <span class="badge bg-info text-dark">
                        {{ r.priorite }}
                        </span>
                   {% endif %}
                </td>


                

                <td>
                  {{ r.dateCreationR ? r.dateCreationR|date('d/m/Y H:i') : '—' }}
                </td>

                <td>
                  {{ r.dateLimite ? r.dateLimite|date('d/m/Y H:i') : '—' }}
                </td>

                <td>
                  {{ r.dateModificationR ? r.dateModificationR|date('d/m/Y H:i') : '—' }}
                </td>

                <td>
                  {{ r.dateClotureR ? r.dateClotureR|date('d/m/Y H:i') : '—' }}
                </td>

              <td class="text-end">
  <div class="btn-group">
    <a href="{{ path('admin_reclamation_repondre', {'id': r.idReclamation}) }}"
       class="btn btn-sm btn-primary">
      Répondre
    </a>

    <a href="{{ path('admin_reclamation_reponses', {'id': r.idReclamation}) }}"
       class="btn btn-sm btn-outline-secondary">
      Voir réponses
    </a>
  </div>
</td>

              </tr>
            {% endfor %}
            </tbody>

          </table>
        </div>

      </div>
    </div>
  {% endif %}

</div>
{% endblock %}
