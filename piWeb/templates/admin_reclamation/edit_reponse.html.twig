{% extends 'base_admin.html.twig' %}

{% block title %}Modifier la réponse{% endblock %}

{% block body %}
<div class="container">

  <div class="mb-4">
    <h2 class="mb-1">Modifier la réponse</h2>
    <p class="text-muted mb-0">
      Réclamation : <strong>{{ reclamation.referenceReclamation }}</strong>
    </p>
  </div>

  {# Flash messages (optionnel mais utile) #}
  {% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  {% endfor %}

  {% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  {% endfor %}

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      {{ form_start(form) }}

      {# TYPE REPONSE #}
      <div class="mb-3">
        {{ form_label(form.typeReponse) }}

        {# Bordure rouge si erreur #}
        {% set typeHasError = form.typeReponse.vars.errors|length > 0 %}
        {{ form_widget(form.typeReponse, {
          'attr': {
            'class': 'form-select ' ~ (typeHasError ? 'is-invalid' : '')
          }
        }) }}

        {# Erreurs en rouge #}
        <div class="text-danger small mt-1">
          {{ form_errors(form.typeReponse) }}
        </div>
      </div>

      {# MESSAGE #}
      <div class="mb-3">
        {{ form_label(form.message) }}

        {# Bordure rouge si erreur #}
        {% set msgHasError = form.message.vars.errors|length > 0 %}
        {{ form_widget(form.message, {
          'attr': {
            'class': 'form-control ' ~ (msgHasError ? 'is-invalid' : ''),
            'rows': 6
          }
        }) }}

        {# Erreurs en rouge #}
        <div class="text-danger small mt-1">
          {{ form_errors(form.message) }}
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2">
        <a href="{{ path('admin_reclamation_reponses', {'id': reclamation.idReclamation}) }}"
           class="btn btn-outline-secondary">
          Annuler
        </a>
        <button class="btn btn-primary">Enregistrer</button>
      </div>

      {{ form_end(form) }}
    </div>
  </div>

</div>
{% endblock %}
