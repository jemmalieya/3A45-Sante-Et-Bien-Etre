{% extends 'base.html.twig' %}

{% block title %}Réclamations{% endblock %}

{% block body %}
<section class="section" style="padding-top: 120px;">
  <div class="container">

    <div class="row justify-content-center">
      <div class="col-lg-8">

        <div class="section-title mb-4">
          <h2>Ajouter une réclamation</h2>
          <p>Décrivez votre problème, nous vous répondrons rapidement.</p>
           <a href="{{ path('reclamation_list') }}"
         class="btn btn-outline-primary"
         title="Voir mes réclamations">
        <i class="bi bi-inbox"></i>
      </a>
        </div>

        {% for message in app.flashes('success') %}
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}

        <div class="card shadow-sm border-0">
          <div class="card-body p-4">

            {# ✅ AJOUT: novalidate (sans changer ton layout) #}
            {{ form_start(form, { 'attr': {'class': 'row g-3', 'novalidate': 'novalidate'} }) }}

              <div class="col-12">
                {{ form_label(form.contenu, 'Contenu', {'label_attr': {'class': 'form-label'}}) }}

                {# ✅ AJOUT: is-invalid si erreur + garder ton placeholder #}
                {{ form_widget(form.contenu, {
                  'attr': {
                    'class': 'form-control ' ~ (form_errors(form.contenu) ? 'is-invalid' : ''),
                    'placeholder': 'Ex: Problème de rendez-vous...'
                  }
                }) }}

                {# ✅ AJOUT: erreurs en rouge #}
                {% if form_errors(form.contenu) %}
                  <div class="text-danger small mt-1">
                    {{ form_errors(form.contenu) }}
                  </div>
                {% endif %}
              </div>

              <div class="col-12">
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}

                {# ✅ AJOUT: is-invalid si erreur + garder rows + placeholder #}
                {{ form_widget(form.description, {
                  'attr': {
                    'class': 'form-control ' ~ (form_errors(form.description) ? 'is-invalid' : ''),
                    'rows': 5,
                    'placeholder': 'Décrivez votre réclamation en détail...'
                  }
                }) }}

                {# ✅ AJOUT: erreurs en rouge #}
                {% if form_errors(form.description) %}
                  <div class="text-danger small mt-1">
                    {{ form_errors(form.description) }}
                  </div>
                {% endif %}
              </div>

              <div class="col-md-6">
                {{ form_label(form.type, 'Type', {'label_attr': {'class': 'form-label'}}) }}

                {# ✅ AJOUT: is-invalid si erreur + garder placeholder #}
                {{ form_widget(form.type, {
                  'attr': {
                    'class': 'form-control ' ~ (form_errors(form.type) ? 'is-invalid' : ''),
                    'placeholder': 'Ex: Service, Paiement, RDV...'
                  }
                }) }}

                {# ✅ AJOUT: erreurs en rouge #}
                {% if form_errors(form.type) %}
                  <div class="text-danger small mt-1">
                    {{ form_errors(form.type) }}
                  </div>
                {% endif %}
              </div>


              <div class="col-12 d-flex gap-2 mt-2">
                <button class="btn btn-primary px-4">
                  Envoyer la réclamation
                </button>
                <button type="reset" class="btn btn-outline-secondary px-4">
                  Annuler
                </button>

              </div>

            {{ form_end(form) }}

          </div>
        </div>

      </div>
    </div>

  </div>
</section>
{% endblock %}
